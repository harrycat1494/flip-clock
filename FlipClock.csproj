<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FlipClock</AssemblyName>
    <RootNamespace>FlipClock</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\flipclock.ico</ApplicationIcon>
    <Product>Flip Clock</Product>
    <AssemblyTitle>Flip Clock</AssemblyTitle>
    <Description>A split-flap clock for the Windows desktop</Description>
    <Company>Flip Clock</Company>
    <Copyright>Copyright (c) 2026 Flip Clock contributors. MIT licence.</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <!-- a clock sits idle all day: prefer a small memory footprint over throughput -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <TieredPGO>false</TieredPGO>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Folder with the flap sounds. To build with your own: -p:FlapDir=path\to\folder
         (WAV files, mono, 16 bit, 44.1 kHz, plain 44-byte header). -->
    <FlapDir Condition="'$(FlapDir)' == ''">Assets\flap</FlapDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- eight single clacks cut from a real split-flap recording (CC0), see THIRD-PARTY-NOTICES.md -->
    <EmbeddedResource Include="$(FlapDir)\*.wav" />
  </ItemGroup>

</Project>
