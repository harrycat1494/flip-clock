<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FlipClock</AssemblyName>
    <RootNamespace>FlipClock</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\flipclock.ico</ApplicationIcon>
    <Product>Flip Clock</Product>
    <AssemblyTitle>Flip Clock</AssemblyTitle>
    <Description>A split-flap clock for the Windows desktop</Description>
    <Company>Flip Clock</Company>
    <Copyright>Copyright (c) 2026 Flip Clock contributors. MIT licence.</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <!-- a clock sits idle all day: prefer a small memory footprint over throughput -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <TieredPGO>false</TieredPGO>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
